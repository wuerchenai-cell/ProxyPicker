<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- 目标 .NET Framework 4.8：Windows 10/11 自带，换机不用装运行时，编译产物约 20 KB -->
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <AssemblyName>ProxyPicker</AssemblyName>
    <RootNamespace>ProxyPicker</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\ProxyPicker.ico</ApplicationIcon>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <Deterministic>true</Deterministic>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <AutoGenerateBindingRedirects>false</AutoGenerateBindingRedirects>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <Product>ProxyPicker</Product>
    <AssemblyTitle>ProxyPicker</AssemblyTitle>
    <Company>ProxyPicker</Company>
    <Version>1.0.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
    <EmbeddedResource Include="Assets\ProxyPicker.ico" />
  </ItemGroup>

</Project>
