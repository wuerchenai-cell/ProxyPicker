<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- ProxyPicker v3.0 深色主题 Design Tokens -->
    <Color x:Key="Color.BgCanvas">#0B1120</Color>
    <Color x:Key="Color.BgSidebar">#0F172A</Color>
    <Color x:Key="Color.BgCard">#151F32</Color>
    <Color x:Key="Color.BgSubtle">#1B273D</Color>
    <Color x:Key="Color.BgHover">#23334F</Color>
    <Color x:Key="Color.BgSelected">#1E3A5F</Color>
    <Color x:Key="Color.Border">#24324A</Color>
    <Color x:Key="Color.BorderStrong">#334666</Color>

    <Color x:Key="Color.TextPrimary">#F1F5F9</Color>
    <Color x:Key="Color.TextSecondary">#94A3B8</Color>
    <Color x:Key="Color.TextMuted">#64748B</Color>

    <Color x:Key="Color.Accent">#3B82F6</Color>
    <Color x:Key="Color.AccentHover">#60A5FA</Color>
    <Color x:Key="Color.AccentSoft">#172554</Color>

    <Color x:Key="Color.Static">#A78BFA</Color>
    <Color x:Key="Color.StaticSoft">#2E1065</Color>

    <Color x:Key="Color.Direct">#94A3B8</Color>
    <Color x:Key="Color.DirectSoft">#1E293B</Color>

    <Color x:Key="Color.Success">#34D399</Color>
    <Color x:Key="Color.SuccessSoft">#064E3B</Color>

    <Color x:Key="Color.Warn">#FBBF24</Color>
    <SolidColorBrush x:Key="Brush.WarnSoft" Color="#451A03" />
    <Color x:Key="Color.WarnSoft">#451A03</Color>

    <Color x:Key="Color.Danger">#F87171</Color>
    <Color x:Key="Color.DangerSoft">#450A0A</Color>

    <SolidColorBrush x:Key="Brush.BgCanvas" Color="{StaticResource Color.BgCanvas}" />
    <SolidColorBrush x:Key="Brush.BgSidebar" Color="{StaticResource Color.BgSidebar}" />
    <SolidColorBrush x:Key="Brush.BgCard" Color="{StaticResource Color.BgCard}" />
    <SolidColorBrush x:Key="Brush.BgSubtle" Color="{StaticResource Color.BgSubtle}" />
    <SolidColorBrush x:Key="Brush.BgHover" Color="{StaticResource Color.BgHover}" />
    <SolidColorBrush x:Key="Brush.BgSelected" Color="{StaticResource Color.BgSelected}" />
    <SolidColorBrush x:Key="Brush.Border" Color="{StaticResource Color.Border}" />
    <SolidColorBrush x:Key="Brush.BorderStrong" Color="{StaticResource Color.BorderStrong}" />

    <SolidColorBrush x:Key="Brush.TextPrimary" Color="{StaticResource Color.TextPrimary}" />
    <SolidColorBrush x:Key="Brush.TextSecondary" Color="{StaticResource Color.TextSecondary}" />
    <SolidColorBrush x:Key="Brush.TextMuted" Color="{StaticResource Color.TextMuted}" />

    <SolidColorBrush x:Key="Brush.Accent" Color="{StaticResource Color.Accent}" />
    <SolidColorBrush x:Key="Brush.AccentHover" Color="{StaticResource Color.AccentHover}" />
    <SolidColorBrush x:Key="Brush.AccentSoft" Color="{StaticResource Color.AccentSoft}" />

    <SolidColorBrush x:Key="Brush.Static" Color="{StaticResource Color.Static}" />
    <SolidColorBrush x:Key="Brush.StaticSoft" Color="{StaticResource Color.StaticSoft}" />

    <SolidColorBrush x:Key="Brush.Direct" Color="{StaticResource Color.Direct}" />
    <SolidColorBrush x:Key="Brush.DirectSoft" Color="{StaticResource Color.DirectSoft}" />

    <SolidColorBrush x:Key="Brush.Success" Color="{StaticResource Color.Success}" />
    <SolidColorBrush x:Key="Brush.SuccessSoft" Color="{StaticResource Color.SuccessSoft}" />

    <SolidColorBrush x:Key="Brush.Warn" Color="{StaticResource Color.Warn}" />

    <SolidColorBrush x:Key="Brush.Danger" Color="{StaticResource Color.Danger}" />
    <SolidColorBrush x:Key="Brush.DangerSoft" Color="{StaticResource Color.DangerSoft}" />
</ResourceDictionary>
