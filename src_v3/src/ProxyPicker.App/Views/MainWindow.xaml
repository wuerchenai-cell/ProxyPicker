<Window x:Class="ProxyPicker.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:pages="clr-namespace:ProxyPicker.App.Views.Pages"
        xmlns:conv="clr-namespace:ProxyPicker.App.Converters"
        Title="ProxyPicker v3.0 — 企业级桌面应用分流工作台"
        Width="1100" Height="700" MinWidth="960" MinHeight="620"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" AllowsTransparency="False" ResizeMode="CanResize"
        Background="{DynamicResource Brush.BgCanvas}"
        FontFamily="{StaticResource Font.Primary}">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="42" CornerRadius="0" GlassFrameThickness="0" ResizeBorderThickness="5" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>
    <Window.Resources>
        <conv:IntEqualsToBoolConverter x:Key="IntEqBool" />
        <conv:BoolToVisConverter x:Key="BoolToVis" />
    </Window.Resources>

    <Border BorderBrush="{DynamicResource Brush.BorderStrong}" BorderThickness="1">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 左侧企业级工作台导航栏 -->
            <Border Grid.Column="0" Background="{DynamicResource Brush.BgSidebar}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="64" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- 品牌标识区（可拖拽标题栏区域） -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,12,0">
                        <Border Width="32" Height="32" CornerRadius="8" Background="{DynamicResource Brush.Accent}" VerticalAlignment="Center" Margin="0,0,10,0">
                            <Path Data="M7,12 L15,12 M12,8 L16,12 L12,16 M15,6 L21,6 M15,18 L21,18"
                                  Stroke="#FFFFFF" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  HorizontalAlignment="Center" VerticalAlignment="Center" Width="22" Height="22" Stretch="Uniform" Margin="5" />
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="ProxyPicker" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource Brush.TextPrimary}" />
                            <TextBlock Text="v3.0 Enterprise" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Accent}" />
                        </StackPanel>
                    </StackPanel>

                    <!-- 6 大一级工作区导航 -->
                    <StackPanel Grid.Row="1" Margin="0,4,0,0">
                        <TextBlock Text="核心分流" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextMuted}" Margin="18,4,0,6" />
                        <RadioButton GroupName="MainNav" Style="{StaticResource NavRadioButton}"
                                     IsChecked="{Binding SelectedNavIndex, Converter={StaticResource IntEqBool}, ConverterParameter=0}">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="M3,3 H10 V10 H3 Z M13,3 H20 V10 H13 Z M3,13 H10 V20 H3 Z M13,13 H20 V20 H13 Z"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                      StrokeThickness="1.6" Width="15" Height="15" Stretch="Uniform" Margin="0,0,10,0" />
                                <TextBlock Text="应用分流" VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>

                        <RadioButton GroupName="MainNav" Style="{StaticResource NavRadioButton}"
                                     IsChecked="{Binding SelectedNavIndex, Converter={StaticResource IntEqBool}, ConverterParameter=1}">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="M4,12 A8,8 0 1,1 20,12 A8,8 0 1,1 4,12 M4,12 H20 M12,4 C15,8 15,16 12,20 C9,16 9,8 12,4"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                      StrokeThickness="1.6" Width="15" Height="15" Stretch="Uniform" Margin="0,0,10,0" />
                                <TextBlock Text="节点与多固定IP" VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>

                        <RadioButton GroupName="MainNav" Style="{StaticResource NavRadioButton}"
                                     IsChecked="{Binding SelectedNavIndex, Converter={StaticResource IntEqBool}, ConverterParameter=2}">
                            <DockPanel LastChildFill="True">
                                <Border DockPanel.Dock="Right" Background="{DynamicResource Brush.AccentSoft}" CornerRadius="8" Padding="6,1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding ActiveConnTotal}" FontFamily="{StaticResource Font.Mono}" FontSize="10.5" Foreground="{DynamicResource Brush.Accent}" FontWeight="SemiBold" />
                                </Border>
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="M3,12 H7 L10,5 L14,19 L17,12 H21"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                          StrokeThickness="1.7" Width="15" Height="15" Stretch="Uniform" Margin="0,0,10,0" />
                                    <TextBlock Text="实时连接监视" VerticalAlignment="Center" />
                                </StackPanel>
                            </DockPanel>
                        </RadioButton>

                        <TextBlock Text="质量与自动化" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextMuted}" Margin="18,14,0,6" />
                        <RadioButton GroupName="MainNav" Style="{StaticResource NavRadioButton}"
                                     IsChecked="{Binding SelectedNavIndex, Converter={StaticResource IntEqBool}, ConverterParameter=3}">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="M12,3 L4,7 V12 C4,16.5 7.5,20 12,21 C16.5,20 20,16.5 20,12 V7 Z M9,12 L11,14 L15,10"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                      StrokeThickness="1.6" Width="15" Height="15" Stretch="Uniform" Margin="0,0,10,0" />
                                <TextBlock Text="链路与DNS体检" VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>

                        <RadioButton GroupName="MainNav" Style="{StaticResource NavRadioButton}"
                                     IsChecked="{Binding SelectedNavIndex, Converter={StaticResource IntEqBool}, ConverterParameter=4}">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="M13,2 L4,14 H11 L10,22 L20,10 H13 Z"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                      StrokeThickness="1.6" Width="15" Height="15" Stretch="Uniform" Margin="0,0,10,0" />
                                <TextBlock Text="四向联动与预设" VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>

                        <RadioButton GroupName="MainNav" Style="{StaticResource NavRadioButton}"
                                     IsChecked="{Binding SelectedNavIndex, Converter={StaticResource IntEqBool}, ConverterParameter=5}">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="M4,6 H20 M4,12 H20 M4,18 H14"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                      StrokeThickness="1.7" Width="15" Height="15" Stretch="Uniform" Margin="0,0,10,0" />
                                <TextBlock Text="系统设置与审计" VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>
                    </StackPanel>

                    <!-- 左下角内核实时状态卡 -->
                    <Border Grid.Row="2" Margin="10,8,10,12" Background="{DynamicResource Brush.BgCard}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" CornerRadius="8" Padding="11,9">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="8" Height="8" Margin="0,0,7,0" VerticalAlignment="Center">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Fill" Value="{DynamicResource Brush.Warn}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding KernelConnected}" Value="True">
                                                    <Setter Property="Fill" Value="{DynamicResource Brush.Success}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                                <TextBlock Text="{Binding ClientName}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextPrimary}" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <TextBlock Text="{Binding WatcherStatusBadge}" FontSize="10.5" Foreground="{DynamicResource Brush.TextMuted}" Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- 右侧主工作区 -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="46" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- 顶部自定义无边框标题栏 -->
                <Border Grid.Row="0" Background="{DynamicResource Brush.BgCanvas}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1" Padding="18,0,8,0">
                    <DockPanel>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock x:Name="PageHeaderTitle" FontSize="15" VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource Text.SectionTitle}">
                                        <Setter Property="Text" Value="应用分流工作台" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedNavIndex}" Value="1"><Setter Property="Text" Value="节点策略与多固定 IP 通道池" /></DataTrigger>
                                            <DataTrigger Binding="{Binding SelectedNavIndex}" Value="2"><Setter Property="Text" Value="实时连接白盒监视器" /></DataTrigger>
                                            <DataTrigger Binding="{Binding SelectedNavIndex}" Value="3"><Setter Property="Text" Value="链路纯净度与 DNS 防泄漏体检" /></DataTrigger>
                                            <DataTrigger Binding="{Binding SelectedNavIndex}" Value="4"><Setter Property="Text" Value="四向对称软件联动与场景预设" /></DataTrigger>
                                            <DataTrigger Binding="{Binding SelectedNavIndex}" Value="5"><Setter Property="Text" Value="系统设置与全链路脱敏审计" /></DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" WindowChrome.IsHitTestVisibleInChrome="True">
                            <Button Content="迷你浮窗" Style="{StaticResource SecondaryButton}" Padding="10,4" FontSize="11.5" Margin="0,0,8,0" Command="{Binding ToggleCompactCommand}" />
                            <Button Content="—" Style="{StaticResource TitleBarButton}" Click="OnMinimizeClick" ToolTip="最小化" />
                            <Button Content="□" Style="{StaticResource TitleBarButton}" Click="OnMaximizeClick" ToolTip="最大化 / 还原" />
                            <Button Content="✕" Style="{StaticResource TitleBarCloseButton}" Click="OnHideToTrayClick" ToolTip="隐藏至托盘继续后台守护" />
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- 6 大页面容器 -->
                <Grid Grid.Row="1" Margin="18,14,18,14">
                    <pages:AppsRoutingView x:Name="PageApps" Visibility="Visible" />
                    <pages:NodesStaticView x:Name="PageNodes" Visibility="Collapsed" />
                    <pages:ConnectionsView x:Name="PageConns" Visibility="Collapsed" />
                    <pages:DiagnosticsView x:Name="PageDiag" Visibility="Collapsed" />
                    <pages:AutomationView x:Name="PageAuto" Visibility="Collapsed" />
                    <pages:SettingsAuditView x:Name="PageSettings" Visibility="Collapsed" />

                    <!-- 右下角非侵入式企业级 Toast 通知条 -->
                    <Border HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,8,56" MaxWidth="380"
                            Background="{DynamicResource Brush.BgCard}" BorderBrush="{DynamicResource Brush.Accent}" BorderThickness="1.5"
                            CornerRadius="9" Padding="14,10" Visibility="{Binding ToastVisible, Converter={StaticResource BoolToVis}}">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="✕" Style="{StaticResource TitleBarButton}" Width="24" Height="24" Margin="8,0,0,0" Click="OnDismissToastClick" />
                            <StackPanel>
                                <TextBlock Text="{Binding ToastTitle}" FontWeight="SemiBold" FontSize="12.5" Foreground="{DynamicResource Brush.TextPrimary}" />
                                <TextBlock Text="{Binding ToastBody}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,2,0,0" />
                            </StackPanel>
                        </DockPanel>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
