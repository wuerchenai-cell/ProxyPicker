<UserControl x:Class="ProxyPicker.App.Views.Pages.NodesStaticView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*" />
            <ColumnDefinition Width="14" />
            <ColumnDefinition Width="1.18*" />
        </Grid.ColumnDefinitions>

        <!-- 左栏：主代理节点策略与超时故障转移备选池 -->
        <Border Grid.Column="0" Style="{StaticResource CardBorder}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="10" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="10" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                        <TextBlock Text="主代理节点池" Style="{StaticResource Text.SectionTitle}" />
                        <TextBlock Text="切换主出口或勾选备选加入故障转移池" Style="{StaticResource Text.Muted}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <Button Grid.Column="1" Content="全部测速" Style="{StaticResource SecondaryButton}" Command="{Binding BenchmarkNodesCommand}" VerticalAlignment="Center" />
                </Grid>

                <DataGrid Grid.Row="2" ItemsSource="{Binding Nodes}" Style="{StaticResource EnterpriseDataGrid}" RowHeight="38">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="备选" Width="46">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding IsCandidate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="节点名称" Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextPrimary}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Type}" FontSize="10.5" Foreground="{DynamicResource Brush.TextMuted}" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="延迟" Binding="{Binding DelayLabel}" Width="78" FontFamily="{StaticResource Font.Mono}" />
                        <DataGridTemplateColumn Header="操作" Width="64">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="切换" Style="{StaticResource SecondaryButton}" Padding="8,3" FontSize="11.5"
                                            Command="{Binding DataContext.SwitchNodeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <DockPanel Grid.Row="4">
                    <CheckBox Style="{StaticResource ToggleSwitch}" Content="主节点连续超时自动切换备选" IsChecked="{Binding AutoFailoverOn}" />
                    <Button Content="保存备选池" Style="{StaticResource SecondaryButton}" Command="{Binding SaveCandidatesCommand}" HorizontalAlignment="Right" />
                </DockPanel>
            </Grid>
        </Border>

        <!-- 右栏：多固定 IP 通道池管理工作区 -->
        <Border Grid.Column="2" Style="{StaticResource CardBorder}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,10,0">
                            <TextBlock Text="多固定 IP 通道池（专属静态出口）" Style="{StaticResource Text.SectionTitle}" />
                            <TextBlock Text="支持多条独立静态 IP 与 10 分钟自动稳速优选" Style="{StaticResource Text.Muted}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <Button Grid.Column="1" Content="+ 新建通道" Style="{StaticResource SecondaryButton}" Command="{Binding AddStaticChannelCommand}" VerticalAlignment="Center" />
                    </Grid>

                    <!-- 已配置通道卡片列表 -->
                    <ItemsControl ItemsSource="{Binding StaticChannels}" Margin="0,0,0,12">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource SubtleCardBorder}" Margin="0,0,0,6" Padding="10,8" Cursor="Hand">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextPrimary}" />
                                                <Border Background="{DynamicResource Brush.StaticSoft}" CornerRadius="4" Padding="6,1" Margin="8,0,0,0">
                                                    <TextBlock Text="{Binding HopModeLabel}" FontSize="10.5" Foreground="{DynamicResource Brush.Static}" />
                                                </Border>
                                                <Border Background="{DynamicResource Brush.SuccessSoft}" CornerRadius="4" Padding="6,1" Margin="6,0,0,0">
                                                    <TextBlock Text="{Binding UdpBadge}" FontSize="10.5" Foreground="{DynamicResource Brush.Success}" />
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Margin="0,3,0,0" FontSize="11.5" Foreground="{DynamicResource Brush.TextSecondary}">
                                                <Run Text="{Binding EndpointMasked, Mode=OneWay}" />
                                                <Run Text="  ·  当前跳板：" />
                                                <Run Text="{Binding LiveHopLabel, Mode=OneWay}" />
                                                <Run Text="  ·  " />
                                                <Run Text="{Binding DelayLabel, Mode=OneWay}" FontWeight="SemiBold" />
                                            </TextBlock>
                                        </StackPanel>
                                        <Button Grid.Column="1" Content="编辑" Style="{StaticResource SecondaryButton}" Padding="9,4" FontSize="11.5" VerticalAlignment="Center"
                                                Command="{Binding DataContext.SelectStaticChannelCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- 一行粘贴快捷导入 -->
                    <Border Style="{StaticResource SubtleCardBorder}" Margin="0,0,0,12" Padding="10,8">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="智能解析" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Command="{Binding ParseQuickPasteCommand}" />
                            <TextBox Style="{StaticResource FluentTextBox}" Tag="粘贴 socks5://user:pass@ip:port 或 ip:port:user:pass 一键解析…"
                                     Text="{Binding QuickPasteInput, UpdateSourceTrigger=PropertyChanged}" />
                        </DockPanel>
                    </Border>

                    <!-- 详细配置表单 -->
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <CheckBox Grid.Column="0" Style="{StaticResource ToggleSwitch}" Content="启用此固定 IP 通道" IsChecked="{Binding EditingChannelEnabled}" />
                        <Button Grid.Column="1" Content="删除此通道" Style="{StaticResource DangerButton}" Padding="10,4" FontSize="11.5" Command="{Binding DeleteStaticChannelCommand}" />
                    </Grid>

                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.2*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="0.8*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="通道备注名" Style="{StaticResource Text.Caption}" Margin="0,0,0,4" />
                            <TextBox Style="{StaticResource FluentTextBox}" Text="{Binding EditingChannelName, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="代理协议" Style="{StaticResource Text.Caption}" Margin="0,0,0,4" />
                            <ComboBox SelectedIndex="{Binding EditingProtocolIndex}" Height="31">
                                <ComboBoxItem Content="SOCKS5（推荐）" />
                                <ComboBoxItem Content="HTTP" />
                            </ComboBox>
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.5*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="0.7*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="服务器地址（IP 或域名）" Style="{StaticResource Text.Caption}" Margin="0,0,0,4" />
                            <TextBox Style="{StaticResource FluentTextBox}" Text="{Binding EditingHost, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="端口" Style="{StaticResource Text.Caption}" Margin="0,0,0,4" />
                            <TextBox Style="{StaticResource FluentTextBox}" Text="{Binding EditingPort, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="用户名（可选）" Style="{StaticResource Text.Caption}" Margin="0,0,0,4" />
                            <TextBox Style="{StaticResource FluentTextBox}" Text="{Binding EditingUsername, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="密码（DPAPI 本机加密保存）" Style="{StaticResource Text.Caption}" Margin="0,0,0,4" />
                            <TextBox Style="{StaticResource FluentTextBox}" Text="{Binding EditingPassword, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="前置跳板策略" Style="{StaticResource Text.Caption}" Margin="0,0,0,4" />
                            <ComboBox SelectedIndex="{Binding EditingHopModeIndex}" Height="31">
                                <ComboBoxItem Content="10 分钟自动优选最稳跳板（推荐）" />
                                <ComboBoxItem Content="始终跟随当前主代理节点" />
                                <ComboBoxItem Content="手动固定指定跳板节点" />
                                <ComboBoxItem Content="本地直连（无前置跳板）" />
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="手动指定跳板名（固定模式时填写）" Style="{StaticResource Text.Caption}" Margin="0,0,0,4" />
                            <TextBox Style="{StaticResource FluentTextBox}" Text="{Binding EditingPinnedNode, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                    </Grid>

                    <CheckBox Style="{StaticResource ToggleSwitch}" Margin="0,2,0,10" IsChecked="{Binding EditingAllowUdp}"
                              Content="允许 UDP 转发（默认关闭，自动拦截 QUIC/UDP 防止真实出口穿透泄漏）" />

                    <TextBlock Text="{Binding StaticOptimizeStatus}" Style="{StaticResource Text.Muted}" Margin="0,0,0,10" TextWrapping="Wrap" />

                    <StackPanel Orientation="Horizontal">
                        <Button Content="保存通道并生效" Style="{StaticResource PrimaryButton}" Command="{Binding SaveStaticChannelCommand}" Margin="0,0,8,0" />
                        <Button Content="立即测延迟" Style="{StaticResource SecondaryButton}" Command="{Binding TestStaticDelayCommand}" Margin="0,0,8,0" />
                        <Button Content="立即稳速优选跳板" Style="{StaticResource SecondaryButton}" Command="{Binding OptimizeStaticChannelCommand}" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
