<UserControl x:Class="ProxyPicker.App.Views.Pages.SettingsAuditView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="0.95*" />
            <ColumnDefinition Width="14" />
            <ColumnDefinition Width="1.25*" />
        </Grid.ColumnDefinitions>

        <!-- 左栏：企业级系统设置、加密配置迁移与还原 -->
        <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Border Style="{StaticResource CardBorder}" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="外观与系统集成" Style="{StaticResource Text.SectionTitle}" Margin="0,0,0,10" />

                        <TextBlock Text="界面主题（支持深/浅双色即时热切换）" Style="{StaticResource Text.Caption}" Margin="0,0,0,5" />
                        <ComboBox SelectedIndex="{Binding ThemeIndex}" Height="31" Margin="0,0,0,12">
                            <ComboBoxItem Content="跟随 Windows 系统主题" />
                            <ComboBoxItem Content="企业深色模式（Dark Slate）" />
                            <ComboBoxItem Content="企业浅色模式（Light Fluent）" />
                        </ComboBox>

                        <CheckBox Style="{StaticResource ToggleSwitch}" Content="开机自动启动 ProxyPicker（当前用户，免管理员权限）"
                                  IsChecked="{Binding MainAutostartOn}" Command="{Binding ToggleAutostartCommand}" Margin="0,0,0,10" />

                        <CheckBox Style="{StaticResource ToggleSwitch}" Content="开启 IPv6 防泄漏（自动关闭内核 IPv6，避免国内 IPv6 直出）"
                                  IsChecked="{Binding Ipv6GuardOn}" Command="{Binding ToggleIpv6GuardCommand}" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardBorder}" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="跨机配置迁移（PBKDF2 + AES-256-HMAC 加密）" Style="{StaticResource Text.SectionTitle}" Margin="0,0,0,4" />
                        <TextBlock Text="一键导出全部规则、多固定 IP 通道、场景预设与四向联动设置；固定 IP 凭据使用您设定的迁移口令高强度加密。"
                                   Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,0,0,10" />
                        <StackPanel Orientation="Horizontal">
                            <Button Content="加密导出配置…" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Click="OnExportBundleClick" />
                            <Button Content="导入配置包…" Style="{StaticResource SecondaryButton}" Click="OnImportBundleClick" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardBorder}">
                    <StackPanel>
                        <TextBlock Text="版本维护与应急还原" Style="{StaticResource Text.SectionTitle}" Margin="0,0,0,6" />
                        <TextBlock Text="{Binding UpdateStatusText}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,0,0,10" />
                        <StackPanel Orientation="Horizontal">
                            <Button Content="检查新版本" Style="{StaticResource SecondaryButton}" Command="{Binding CheckUpdateCommand}" Margin="0,0,8,0" />
                            <Button Content="一键彻底还原内核" Style="{StaticResource DangerButton}" Command="{Binding RestoreKernelCommand}" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- 右栏：可搜索彩色审计日志时间线 -->
        <Border Grid.Column="2" Style="{StaticResource CardBorder}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="10" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="10" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                        <TextBlock Text="全链路脱敏审计日志时间线" Style="{StaticResource Text.SectionTitle}" />
                        <TextBlock Text="记录内核推送、固定 IP 优选、四向联动与自愈事件（隐私自动脱敏）" Style="{StaticResource Text.Muted}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <Button Grid.Column="1" Content="刷新日志" Style="{StaticResource SecondaryButton}" Command="{Binding RefreshAuditCommand}" VerticalAlignment="Center" />
                </Grid>

                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <ComboBox Grid.Column="0" SelectedValuePath="Content" SelectedValue="{Binding AuditCategoryFilter}" Height="31">
                        <ComboBoxItem Content="全部" />
                        <ComboBoxItem Content="APPLY" />
                        <ComboBoxItem Content="STATIC" />
                        <ComboBoxItem Content="COMPANION" />
                        <ComboBoxItem Content="WATCH" />
                        <ComboBoxItem Content="PRESET" />
                        <ComboBoxItem Content="CONFIG" />
                    </ComboBox>
                    <TextBox Grid.Column="2" Style="{StaticResource FluentTextBox}" Height="31"
                             Tag="搜索审计日志关键词…"
                             Text="{Binding AuditSearchText, UpdateSourceTrigger=PropertyChanged}" />
                </Grid>

                <DataGrid Grid.Row="4" ItemsSource="{Binding FilteredAudits}" Style="{StaticResource EnterpriseDataGrid}" RowHeight="NaN" MinRowHeight="40">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="时间" Binding="{Binding Timestamp}" Width="138" FontFamily="{StaticResource Font.Mono}" Foreground="{DynamicResource Brush.TextMuted}" />
                        <DataGridTemplateColumn Header="分类" Width="100">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource Brush.AccentSoft}" CornerRadius="4" Padding="6,1.5" HorizontalAlignment="Left">
                                        <TextBlock Text="{Binding Category}" FontFamily="{StaticResource Font.Mono}" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Accent}" />
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="事件详情" Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Margin="0,7" VerticalAlignment="Center" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
