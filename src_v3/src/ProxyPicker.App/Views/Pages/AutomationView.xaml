<UserControl x:Class="ProxyPicker.App.Views.Pages.AutomationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,0,4,10">
            <!-- 上半区：四向对称软件联动闭环工作台 -->
            <Border Style="{StaticResource CardBorder}" Margin="0,0,0,14">
                <StackPanel>
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,14,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="四向对称软件联动（开 A ↔ 开 B · 关 A ↔ 关 B）" Style="{StaticResource Text.SectionTitle}" />
                                <Border CornerRadius="10" Padding="8,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="{DynamicResource Brush.DirectSoft}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding WatcherAlive}" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource Brush.SuccessSoft}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding WatcherStatusBadge}" FontSize="11" FontWeight="SemiBold">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding WatcherAlive}" Value="True">
                                                        <Setter Property="Foreground" Value="{DynamicResource Brush.Success}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>
                            </StackPanel>
                            <TextBlock Text="v3.0 彻底补全四向闭环：勾选跟随默认立即激活后台静默守望；退出 ProxyPicker 时先 P0 还原内核，再按「业务软件 → 代理客户端」优雅关闭。"
                                       Style="{StaticResource Text.Caption}" Margin="0,3,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                        <Button Grid.Column="1" Content="保存并激活四向联动" Style="{StaticResource PrimaryButton}" Command="{Binding SaveCompanionCommand}" VerticalAlignment="Center" />
                    </Grid>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- 左：方向 1 & 3（跟随主软件同开同关） -->
                        <Border Grid.Column="0" Style="{StaticResource SubtleCardBorder}" Padding="14,12">
                            <StackPanel>
                                <TextBlock Text="方向 ① &amp; ③：跟随主软件自动启停" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource Brush.TextPrimary}" Margin="0,0,0,8" />
                                <CheckBox Style="{StaticResource ToggleSwitch}" Content="开启跟随联动（打开它时自动拉起 ProxyPicker）" IsChecked="{Binding CompFollowEnabled}" Margin="0,0,0,8" />

                                <DockPanel Margin="0,0,0,8">
                                    <Button DockPanel.Dock="Right" Content="选择软件…" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Click="OnPickFollowAppClick" />
                                    <TextBox Style="{StaticResource FluentTextBox}" IsReadOnly="True" Text="{Binding CompFollowAppPath}"
                                             ToolTip="请选择要跟随的主软件（如 Clash Verge、Antigravity 等）" />
                                </DockPanel>

                                <CheckBox Style="{StaticResource ToggleSwitch}" Content="开机静默守望并保存即激活（彻底省去手点）" IsChecked="{Binding CompFollowWatchAtLogon}" Margin="0,2,0,6" />
                                <CheckBox Style="{StaticResource ToggleSwitch}" Content="主软件彻底退出时，ProxyPicker 同步自动退出并还原" IsChecked="{Binding CompFollowAutoExit}" Margin="0,0,0,10" />

                                <Button Content="在桌面创建该软件的原生图标联动快捷方式" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left" Command="{Binding CreateDesktopShortcutCommand}" />
                            </StackPanel>
                        </Border>

                        <!-- 右：方向 2 & 4（打开我同开 / 退出我优雅同关） -->
                        <Border Grid.Column="2" Style="{StaticResource SubtleCardBorder}" Padding="14,12">
                            <StackPanel>
                                <TextBlock Text="方向 ② &amp; ④：随 ProxyPicker 自动拉起与退出同关" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource Brush.TextPrimary}" Margin="0,0,0,8" />
                                <CheckBox Style="{StaticResource ToggleSwitch}" Content="打开 ProxyPicker 时自动按序拉起以下软件" IsChecked="{Binding CompLaunchEnabled}" Margin="0,0,0,6" />
                                <CheckBox Style="{StaticResource ToggleSwitch}" Content="退出 ProxyPicker 时同步优雅关闭联动软件（先业务后代理）" IsChecked="{Binding CompCloseLinkedOnExit}" Margin="0,0,0,8" />

                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="伴随软件（代理客户端先开后关，业务软件待规则就绪后开）：" Style="{StaticResource Text.Muted}" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,8,0" />
                                    <Button Grid.Column="1" Content="+ 添加软件" Style="{StaticResource SecondaryButton}" Padding="9,3.5" FontSize="11.5" VerticalAlignment="Center" Click="OnAddLaunchAppClick" />
                                </Grid>

                                <ItemsControl ItemsSource="{Binding CompanionLaunchApps}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{DynamicResource Brush.BgCard}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" CornerRadius="6" Padding="9,6" Margin="0,0,0,5">
                                                <DockPanel>
                                                    <Button DockPanel.Dock="Right" Content="移除" Style="{StaticResource SecondaryButton}" Padding="7,2" FontSize="11"
                                                            Command="{Binding DataContext.RemoveLaunchAppCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}" />
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource Brush.TextPrimary}" />
                                                        <TextBlock Text="{Binding KindBadge}" FontSize="10.5" Foreground="{DynamicResource Brush.TextMuted}" />
                                                    </StackPanel>
                                                </DockPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 下半区：命名场景预设一键切换 -->
            <Border Style="{StaticResource CardBorder}">
                <StackPanel>
                    <TextBlock Text="命名场景预设（一键整套切换分流名单、模式与默认固定 IP）" Style="{StaticResource Text.SectionTitle}" Margin="0,0,0,4" />
                    <TextBlock Text="适合在「AI 深度开发」「跨境运营」「会议办公直连」等多套分流组合间秒级切换。" Style="{StaticResource Text.Caption}" Margin="0,0,0,10" />

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="1.6*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Style="{StaticResource FluentTextBox}" Tag="输入预设名称（如：AI 深度开发）" Text="{Binding NewPresetName, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBox Grid.Column="2" Style="{StaticResource FluentTextBox}" Tag="可选：一句话描述该分流场景用途" Text="{Binding NewPresetDesc, UpdateSourceTrigger=PropertyChanged}" />
                        <Button Grid.Column="4" Content="保存当前状态为预设" Style="{StaticResource PrimaryButton}" Command="{Binding SavePresetCommand}" />
                    </Grid>

                    <ItemsControl ItemsSource="{Binding Presets}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource SubtleCardBorder}" Margin="0,0,0,7" Padding="12,9">
                                    <DockPanel>
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Content="一键切换" Style="{StaticResource PrimaryButton}" Padding="11,5" FontSize="12" Margin="0,0,6,0"
                                                    Command="{Binding DataContext.ApplyPresetCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}" />
                                            <Button Content="删除" Style="{StaticResource SecondaryButton}" Padding="9,5" FontSize="12"
                                                    Command="{Binding DataContext.DeletePresetCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}" />
                                        </StackPanel>
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource Brush.TextPrimary}" />
                                                <Border Background="{DynamicResource Brush.AccentSoft}" CornerRadius="4" Padding="6,1" Margin="8,0,0,0">
                                                    <TextBlock Text="{Binding MetaSummary}" FontSize="10.5" Foreground="{DynamicResource Brush.Accent}" />
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Text="{Binding Description}" Style="{StaticResource Text.Muted}" Margin="0,2,0,0" />
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
