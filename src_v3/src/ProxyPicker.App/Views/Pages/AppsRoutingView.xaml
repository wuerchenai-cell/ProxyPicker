<UserControl x:Class="ProxyPicker.App.Views.Pages.AppsRoutingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:ProxyPicker.App.Controls"
             xmlns:conv="clr-namespace:ProxyPicker.App.Converters">
    <UserControl.Resources>
        <conv:BoolToVisConverter x:Key="BoolToVis" />
        <conv:IntEqualsToBoolConverter x:Key="IntEqBool" />
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 顶部双独立企业级仪表盘：左=双通道实时延迟卡，右=三路流量走势图卡 -->
        <Grid Grid.Row="0" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.05*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="1*" />
            </Grid.ColumnDefinitions>

            <!-- 左仪表卡：主代理 + 独立固定 IP 独立双延迟 -->
            <Border Grid.Column="0" Style="{StaticResource CardBorder}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="10" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="8" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <DockPanel Grid.Row="0">
                        <TextBlock Text="出站通道状态" Style="{StaticResource Text.SectionTitle}" />
                        <TextBlock Text="{Binding KernelSummary}" Style="{StaticResource Text.Muted}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                    </DockPanel>

                    <!-- 主代理行 -->
                    <Border Grid.Row="2" Style="{StaticResource SubtleCardBorder}" Padding="11,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Background="{DynamicResource Brush.AccentSoft}" CornerRadius="5" Padding="7,3" VerticalAlignment="Center" Margin="0,0,10,0">
                                <TextBlock Text="主代理" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Accent}" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding PrimaryNodeName}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextPrimary}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding ClientName}" Style="{StaticResource Text.Muted}" FontSize="11" />
                            </StackPanel>
                            <Border Grid.Column="2" Background="{DynamicResource Brush.BgCard}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" CornerRadius="6" Padding="9,4" VerticalAlignment="Center">
                                <TextBlock Text="{Binding PrimaryDelayText}" FontFamily="{StaticResource Font.Mono}" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Success}" />
                            </Border>
                        </Grid>
                    </Border>

                    <!-- 固定 IP 行 -->
                    <Border Grid.Row="4" Style="{StaticResource SubtleCardBorder}" Padding="11,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Background="{DynamicResource Brush.StaticSoft}" CornerRadius="5" Padding="7,3" VerticalAlignment="Center" Margin="0,0,10,0">
                                <TextBlock Text="固定IP" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Static}" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding StaticChannelSummary}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextPrimary}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding StaticHopSummary}" Style="{StaticResource Text.Muted}" FontSize="11" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <Border Grid.Column="2" Background="{DynamicResource Brush.BgCard}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" CornerRadius="6" Padding="9,4" VerticalAlignment="Center">
                                <TextBlock Text="{Binding StaticDelayText}" FontFamily="{StaticResource Font.Mono}" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Static}" />
                            </Border>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <!-- 右仪表卡：三色实时流量走势图 -->
            <Border Grid.Column="2" Style="{StaticResource CardBorder}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="8" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="8" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0">
                        <TextBlock Text="实时三路吞吐" Style="{StaticResource Text.SectionTitle}" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <TextBlock Text="活跃连接 " Style="{StaticResource Text.Muted}" />
                            <TextBlock Text="{Binding ActiveConnTotal}" FontFamily="{StaticResource Font.Mono}" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextPrimary}" />
                        </StackPanel>
                    </DockPanel>

                    <UniformGrid Grid.Row="2" Columns="3">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="7" Height="7" Fill="{DynamicResource Brush.Accent}" Margin="0,0,5,0" />
                                <TextBlock Text="主代理" Style="{StaticResource Text.Muted}" FontSize="11" />
                            </StackPanel>
                            <TextBlock Text="{Binding ProxySpeedText}" FontFamily="{StaticResource Font.Mono}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Accent}" Margin="0,2,0,0" />
                        </StackPanel>
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="7" Height="7" Fill="{DynamicResource Brush.Static}" Margin="0,0,5,0" />
                                <TextBlock Text="固定IP" Style="{StaticResource Text.Muted}" FontSize="11" />
                            </StackPanel>
                            <TextBlock Text="{Binding StaticSpeedText}" FontFamily="{StaticResource Font.Mono}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Static}" Margin="0,2,0,0" />
                        </StackPanel>
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="7" Height="7" Fill="{DynamicResource Brush.Direct}" Margin="0,0,5,0" />
                                <TextBlock Text="本地直连" Style="{StaticResource Text.Muted}" FontSize="11" />
                            </StackPanel>
                            <TextBlock Text="{Binding DirectSpeedText}" FontFamily="{StaticResource Font.Mono}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextSecondary}" Margin="0,2,0,0" />
                        </StackPanel>
                    </UniformGrid>

                    <Border Grid.Row="4" Background="{DynamicResource Brush.BgSubtle}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" CornerRadius="7" Padding="6,4" MinHeight="62">
                        <controls:SparklineChart x:Name="TrafficSparkline"
                                                 ProxyBrush="{DynamicResource Brush.Accent}"
                                                 StaticBrush="{DynamicResource Brush.Static}"
                                                 DirectBrush="{DynamicResource Brush.Direct}"
                                                 GridBrush="{DynamicResource Brush.Border}"
                                                 LabelBrush="{DynamicResource Brush.TextMuted}" />
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- 工具栏：筛选胶囊 + 搜索框 + 模式切换 + 添加 exe -->
        <Grid Grid.Row="1" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <RadioButton Content="全部" GroupName="AppFilter" Style="{StaticResource FilterPill}" IsChecked="{Binding AppFilterTab, Converter={StaticResource IntEqBool}, ConverterParameter=0}" />
                <RadioButton Content="运行中" GroupName="AppFilter" Style="{StaticResource FilterPill}" IsChecked="{Binding AppFilterTab, Converter={StaticResource IntEqBool}, ConverterParameter=1}" />
                <RadioButton Content="主代理" GroupName="AppFilter" Style="{StaticResource FilterPill}" IsChecked="{Binding AppFilterTab, Converter={StaticResource IntEqBool}, ConverterParameter=2}" />
                <RadioButton Content="固定IP" GroupName="AppFilter" Style="{StaticResource FilterPill}" IsChecked="{Binding AppFilterTab, Converter={StaticResource IntEqBool}, ConverterParameter=3}" />
            </StackPanel>

            <TextBox Grid.Column="1" Style="{StaticResource FluentTextBox}" Margin="8,0,10,0" Height="32"
                     Tag="搜索软件名称或进程名（如 chrome / antigravity）…"
                     Text="{Binding AppSearchText, UpdateSourceTrigger=PropertyChanged}" />

            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <Border Background="{DynamicResource Brush.BgSubtle}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" CornerRadius="6" Padding="2" Margin="0,0,8,0">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton Content="白名单模式" GroupName="SplitMode" Style="{StaticResource ChannelSegButton}"
                                     IsChecked="{Binding SplitModeIndex, Converter={StaticResource IntEqBool}, ConverterParameter=0}"
                                     ToolTip="未分配的软件一律本地直连（推荐）" />
                        <RadioButton Content="订阅兼容" GroupName="SplitMode" Style="{StaticResource ChannelSegButton}"
                                     IsChecked="{Binding SplitModeIndex, Converter={StaticResource IntEqBool}, ConverterParameter=1}"
                                     ToolTip="未分配的软件沿用代理客户端原有订阅分流规则" />
                    </StackPanel>
                </Border>
                <Button Content="+ 添加软件" Style="{StaticResource SecondaryButton}" Height="32" Click="OnAddCustomAppClick" />
            </StackPanel>
        </Grid>

        <!-- 主体软件分流表格：三态直切胶囊 -->
        <Border Grid.Row="2" Style="{StaticResource CardBorder}" Padding="0">
            <DataGrid ItemsSource="{Binding FilteredApps}" Style="{StaticResource EnterpriseDataGrid}">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="应用名称" Width="1.6*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Ellipse Width="7" Height="7" Margin="0,0,9,0" VerticalAlignment="Center">
                                        <Ellipse.Style>
                                            <Style TargetType="Ellipse">
                                                <Setter Property="Fill" Value="{DynamicResource Brush.BorderStrong}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Running}" Value="True">
                                                        <Setter Property="Fill" Value="{DynamicResource Brush.Success}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Ellipse.Style>
                                    </Ellipse>
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextPrimary}" />
                                            <Border Background="{DynamicResource Brush.DangerSoft}" CornerRadius="4" Padding="5,1" Margin="8,0,0,0"
                                                    Visibility="{Binding IsMismatched, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Text="旧连接错路" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Danger}" />
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="{Binding Exe}" FontFamily="{StaticResource Font.Mono}" FontSize="11" Foreground="{DynamicResource Brush.TextMuted}" />
                                    </StackPanel>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTextColumn Header="运行与活跃连接" Binding="{Binding StatusSummary}" Width="1.05*" Foreground="{DynamicResource Brush.TextSecondary}" />

                    <DataGridTemplateColumn Header="出站分流通道（一键直切）" Width="255">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource Brush.BgSubtle}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" CornerRadius="7" Padding="2" HorizontalAlignment="Left">
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton Content="直连" GroupName="{Binding RadioGroupName}" Style="{StaticResource ChannelSegButton}" IsChecked="{Binding IsDirect, Mode=TwoWay}" />
                                        <RadioButton Content="主代理" GroupName="{Binding RadioGroupName}" Style="{StaticResource ChannelSegProxy}" IsChecked="{Binding IsPrimaryProxy, Mode=TwoWay}" />
                                        <RadioButton Content="固定IP" GroupName="{Binding RadioGroupName}" Style="{StaticResource ChannelSegStatic}" IsChecked="{Binding IsStaticChannel, Mode=TwoWay}" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- 底部提交操作栏 -->
        <Border Grid.Row="3" Margin="0,12,0,0" Style="{StaticResource CardBorder}" Padding="14,10">
            <DockPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="8" Height="8" Margin="0,0,8,0">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="{DynamicResource Brush.Success}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasUnsavedRoutingChanges}" Value="True">
                                        <Setter Property="Fill" Value="{DynamicResource Brush.Warn}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <TextBlock VerticalAlignment="Center" FontSize="12.5" Foreground="{DynamicResource Brush.TextSecondary}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="{Binding StatusMessage}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasUnsavedRoutingChanges}" Value="True">
                                        <Setter Property="Text" Value="检测到未保存的路由修改，点击右侧按钮立即热推至代理内核（仅重连变动软件）" />
                                        <Setter Property="Foreground" Value="{DynamicResource Brush.Warn}" />
                                        <Setter Property="FontWeight" Value="SemiBold" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="刷新列表" Style="{StaticResource SecondaryButton}" Command="{Binding RefreshCommand}" Margin="0,0,8,0" />
                    <Button Content="保存并热推生效" Style="{StaticResource PrimaryButton}" Command="{Binding SaveRulesCommand}" MinWidth="136" />
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
