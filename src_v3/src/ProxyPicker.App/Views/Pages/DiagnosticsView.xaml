<UserControl x:Class="ProxyPicker.App.Views.Pages.DiagnosticsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:ProxyPicker.App.Converters">
    <UserControl.Resources>
        <conv:BoolToVisConverter x:Key="BoolToVis" />
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- DNS 防泄漏与内核安全只读诊断卡片 -->
        <Border Grid.Row="0" Style="{StaticResource CardBorder}" Margin="0,0,0,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="8" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="6" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="DNS 防泄漏与通道安全体检（只读建议）" Style="{StaticResource Text.SectionTitle}" />
                        <Border Background="{DynamicResource Brush.SuccessSoft}" CornerRadius="5" Padding="7,2" Margin="10,0,0,0">
                            <TextBlock FontSize="11" Foreground="{DynamicResource Brush.Success}" FontWeight="SemiBold">
                                <Run Text="TUN: " /><Run Text="{Binding DnsTunEnabled, Mode=OneWay}" />
                            </TextBlock>
                        </Border>
                        <Border Background="{DynamicResource Brush.AccentSoft}" CornerRadius="5" Padding="7,2" Margin="6,0,0,0">
                            <TextBlock FontSize="11" Foreground="{DynamicResource Brush.Accent}" FontWeight="SemiBold">
                                <Run Text="内核 DNS: " /><Run Text="{Binding DnsKernelEnabled, Mode=OneWay}" />
                            </TextBlock>
                        </Border>
                        <Border Background="{DynamicResource Brush.StaticSoft}" CornerRadius="5" Padding="7,2" Margin="6,0,0,0">
                            <TextBlock FontSize="11" Foreground="{DynamicResource Brush.Static}" FontWeight="SemiBold">
                                <Run Text="固定IP UDP防护: " /><Run Text="{Binding DnsUdpGuardActive, Mode=OneWay}" />
                            </TextBlock>
                        </Border>
                    </StackPanel>
                    <Button Content="复制脱敏诊断报告" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Right" Command="{Binding CopyDiagnosticReportCommand}" />
                </DockPanel>

                <TextBlock Grid.Row="2" Text="{Binding DnsSummary}" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextPrimary}" TextWrapping="Wrap" />

                <ItemsControl Grid.Row="4" ItemsSource="{Binding DnsRecommendations}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                <TextBlock Text="• " Foreground="{DynamicResource Brush.Accent}" FontWeight="Bold" />
                                <TextBlock Text="{Binding}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </Border>

        <!-- 节点风控检测工具栏 + 最新结论摘要 -->
        <Border Grid.Row="1" Style="{StaticResource CardBorder}" Margin="0,0,0,12" Padding="14,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="8" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding LatestQualityHeadline}" Style="{StaticResource Text.SectionTitle}" />
                        <TextBlock Text="{Binding LatestQualityDetail}" Style="{StaticResource Text.Caption}" Margin="0,2,0,0" TextWrapping="Wrap" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button Content="检测当前节点" Style="{StaticResource PrimaryButton}" Command="{Binding ProbeCurrentNodeCommand}" Margin="0,0,8,0" />
                        <Button Content="全量旁路风控体检" Style="{StaticResource SecondaryButton}" Command="{Binding ProbeAllNodesCommand}" Margin="0,0,8,0" />
                        <Button Content="停止" Style="{StaticResource DangerButton}" Command="{Binding CancelQualityProbeCommand}"
                                Visibility="{Binding QualityRunning, Converter={StaticResource BoolToVis}}" />
                    </StackPanel>
                </DockPanel>

                <TextBlock Grid.Row="2" Text="{Binding QualityProgressText}" Style="{StaticResource Text.Muted}" />
            </Grid>
        </Border>

        <!-- 节点质量评估矩阵表格 -->
        <Border Grid.Row="2" Style="{StaticResource CardBorder}" Padding="0">
            <DataGrid ItemsSource="{Binding QualityReports}" Style="{StaticResource EnterpriseDataGrid}" RowHeight="40">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="检测节点" Binding="{Binding NodeName}" Width="1.2*" FontWeight="SemiBold" />
                    <DataGridTemplateColumn Header="风险评级" Width="88">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border CornerRadius="5" Padding="7,2" HorizontalAlignment="Left">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="{DynamicResource Brush.DirectSoft}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding RiskTone}" Value="low">
                                                    <Setter Property="Background" Value="{DynamicResource Brush.SuccessSoft}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding RiskTone}" Value="med">
                                                    <Setter Property="Background" Value="{DynamicResource Brush.WarnSoft}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding RiskTone}" Value="high">
                                                    <Setter Property="Background" Value="{DynamicResource Brush.DangerSoft}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding RiskBadge}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextPrimary}" />
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="风险分" Binding="{Binding RiskScoreText}" Width="80" FontFamily="{StaticResource Font.Mono}" />
                    <DataGridTextColumn Header="落地地区与属性" Binding="{Binding RegionAndKind}" Width="1.15*" />
                    <DataGridTextColumn Header="延迟/抖动" Binding="{Binding LatencyText}" Width="88" FontFamily="{StaticResource Font.Mono}" />
                    <DataGridTextColumn Header="Google" Binding="{Binding GoogleStatus}" Width="68" />
                    <DataGridTextColumn Header="Gemini" Binding="{Binding GeminiStatus}" Width="68" />
                    <DataGridTextColumn Header="OpenAI" Binding="{Binding OpenAiStatus}" Width="68" />
                    <DataGridTextColumn Header="Claude" Binding="{Binding ClaudeStatus}" Width="68" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>
