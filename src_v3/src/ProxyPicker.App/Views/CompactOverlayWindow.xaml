<Window x:Class="ProxyPicker.App.Views.CompactOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ProxyPicker 迷你监控" Width="320" Height="156"
        WindowStyle="None" ResizeMode="NoResize" Topmost="True" ShowInTaskbar="False"
        Background="{DynamicResource Brush.BgCard}" FontFamily="{StaticResource Font.Primary}">
    <Border BorderBrush="{DynamicResource Brush.Accent}" BorderThickness="1.2" Padding="14,10" MouseLeftButtonDown="OnDragMove">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="10" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="10" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <DockPanel Grid.Row="0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="8" Height="8" Fill="{DynamicResource Brush.Success}" Margin="0,0,7,0" />
                    <TextBlock Text="ProxyPicker v3.0" FontWeight="SemiBold" FontSize="12.5" Foreground="{DynamicResource Brush.TextPrimary}" />
                </StackPanel>
                <Button Content="展开主界面" Style="{StaticResource SecondaryButton}" Padding="8,2.5" FontSize="11" HorizontalAlignment="Right" Click="OnExpandClick" />
            </DockPanel>

            <UniformGrid Grid.Row="2" Columns="2">
                <Border Style="{StaticResource SubtleCardBorder}" Margin="0,0,4,0" Padding="8,6">
                    <StackPanel>
                        <TextBlock Text="主代理" FontSize="10.5" Foreground="{DynamicResource Brush.Accent}" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding PrimaryDelayText}" FontFamily="{StaticResource Font.Mono}" FontSize="13.5" FontWeight="Bold" Foreground="{DynamicResource Brush.TextPrimary}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource SubtleCardBorder}" Margin="4,0,0,0" Padding="8,6">
                    <StackPanel>
                        <TextBlock Text="独立固定IP" FontSize="10.5" Foreground="{DynamicResource Brush.Static}" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding StaticDelayText}" FontFamily="{StaticResource Font.Mono}" FontSize="13.5" FontWeight="Bold" Foreground="{DynamicResource Brush.TextPrimary}" />
                    </StackPanel>
                </Border>
            </UniformGrid>

            <UniformGrid Grid.Row="4" Columns="3">
                <StackPanel>
                    <TextBlock Text="主代理" FontSize="10" Foreground="{DynamicResource Brush.TextMuted}" />
                    <TextBlock Text="{Binding ProxySpeedText}" FontFamily="{StaticResource Font.Mono}" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Accent}" />
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="固定IP" FontSize="10" Foreground="{DynamicResource Brush.TextMuted}" />
                    <TextBlock Text="{Binding StaticSpeedText}" FontFamily="{StaticResource Font.Mono}" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Static}" />
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="直连" FontSize="10" Foreground="{DynamicResource Brush.TextMuted}" />
                    <TextBlock Text="{Binding DirectSpeedText}" FontFamily="{StaticResource Font.Mono}" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextSecondary}" />
                </StackPanel>
            </UniformGrid>
        </Grid>
    </Border>
</Window>
